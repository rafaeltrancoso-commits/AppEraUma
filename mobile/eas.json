{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.erauma.app.br/api",
        "EXPO_PUBLIC_FEATURE_MOMENTS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testing": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.erauma.app.br/api",
        "EXPO_PUBLIC_FEATURE_MOMENTS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.erauma.app.br/api",
        "EXPO_PUBLIC_FEATURE_MOMENTS": "false"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.erauma.app.br/api",
        "EXPO_PUBLIC_FEATURE_MOMENTS": "false"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    }
  }
}
