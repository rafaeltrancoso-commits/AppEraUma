SPRING_PROFILES_ACTIVE=prod

PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

JWT_SECRET=
JWT_EXPIRATION_MINUTES=

# Obrigatorias em producao: ResendEmailService falha ao iniciar (fail-fast) se
# RESEND_API_KEY, APP_EMAIL_FROM ou APP_PASSWORD_RESET_URL estiverem vazias.
RESEND_API_KEY=
APP_EMAIL_FROM=EraUma <noreply@erauma.app.br>
APP_PASSWORD_RESET_URL=https://erauma.app.br/reset-password
APP_EMAIL_TIMEOUT_SECONDS=10

APP_STORY_GENERATOR=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=

OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=
OPENAI_IMAGE_QUALITY=
OPENAI_IMAGE_TIMEOUT_SECONDS=
APP_STORY_IMAGE_GENERATION_ENABLED=
APP_STORY_MAX_IMAGES=
APP_STORY_ILLUSTRATED_DAILY_LIMIT=
APP_STORY_MAX_ATTEMPTS=3
APP_STORY_IMAGE_MAX_ATTEMPTS=3

APP_STORAGE_ROOT=/data/storage

APP_CORS_ALLOWED_ORIGINS=https://erauma.app.br

APP_PASSWORD_RESET_EXPOSE_TOKEN=false

# Opcionais: limite de tentativas por IP em login/registro/esqueci-minha-senha.
# Sem estas variaveis, os padroes sao: login 10, registro 5, esqueci-senha 5
# tentativas por 300s (5 min). Limitador somente em memoria (nao distribuido
# entre instancias, perde o estado a cada redeploy) - ver AuthRateLimitFilter.
APP_AUTH_RATE_LIMIT_ENABLED=true
APP_AUTH_RATE_LIMIT_MAX_REQUESTS=10
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
APP_AUTH_RATE_LIMIT_REGISTER_MAX_REQUESTS=5
APP_AUTH_RATE_LIMIT_FORGOT_PASSWORD_MAX_REQUESTS=5
APP_AUTH_RATE_LIMIT_MAX_TRACKED_KEYS=50000

NIXPACKS_JDK_VERSION=21
