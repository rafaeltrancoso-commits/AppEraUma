POSTGRES_DB=erauma
POSTGRES_USER=erauma
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5433
JWT_SECRET=change-me-to-a-long-random-secret-with-at-least-32-characters
RESEND_API_KEY=
APP_EMAIL_FROM=EraUma <noreply@erauma.app.br>
APP_PASSWORD_RESET_URL=https://erauma.app.br/reset-password
APP_EMAIL_TIMEOUT_SECONDS=10
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.0.6:8081
APP_PASSWORD_RESET_EXPOSE_TOKEN=true
EXPO_PUBLIC_API_URL=http://localhost:8080/api
APP_STORAGE_ROOT=storage
MOMENT_MAX_PHOTOS=10
MOMENT_MAX_PHOTO_SIZE_MB=10
APP_STORY_GENERATOR=mock
APP_STORY_AI_FALLBACK_ENABLED=true
APP_STORY_DAILY_LIMIT=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
APP_STORY_IMAGE_GENERATION_ENABLED=true
APP_STORY_MAX_IMAGES=4
APP_STORY_ILLUSTRATED_DAILY_LIMIT=20
APP_STORY_IMAGE_LOW_COST_USD=0.01
APP_STORY_IMAGE_MEDIUM_COST_USD=0.04
APP_STORY_IMAGE_HIGH_COST_USD=0.08
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_SECONDS=60
APP_AI_AUDIO_ENABLED=false
APP_STORY_AUDIO_MAX_ATTEMPTS=3
APP_STORY_AUDIO_CHUNK_MAX_CHARACTERS=4000
OPENAI_AUDIO_MODEL=gpt-4o-mini-tts
OPENAI_AUDIO_VOICE=marin
OPENAI_AUDIO_FORMAT=mp3
OPENAI_AUDIO_TIMEOUT_SECONDS=60
# Opcional: descomente apenas para substituir o estilo seguro definido em application.yml.
# OPENAI_AUDIO_INSTRUCTIONS=Narre em portugues brasileiro e preserve exatamente o texto fornecido.
